#!/usr/bin/env node
import fs from "node:fs";

const plan = JSON.parse(fs.readFileSync("docs/releases/plan.json", "utf8"));
const manifest = JSON.parse(fs.readFileSync("package.json", "utf8"));

if (plan.schemaVersion !== 2 || plan.repository !== "Meshrix.js") {
  throw new Error("release plan identity is invalid");
}
if (plan.currentVersion !== manifest.version) {
  throw new Error("release plan version does not match package.json");
}
if (!fs.existsSync(plan.changelog)) {
  throw new Error("release plan changelog is missing");
}

process.stdout.write("version-governance: ok\n");
