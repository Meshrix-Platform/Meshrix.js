{
  "$schema": "./schema/module.schema.json",
  "version": "v0.1.0",
  "modules": [
    {
      "id": "contracts",
      "kind": "foundation",
      "owner": "platform",
      "directory": "packages/contracts",
      "chineseName": "契约",
      "description": "Operation and module contracts.",
      "publicApi": [
        "#lico/contracts/*"
      ]
    },
    {
      "id": "foundation",
      "kind": "foundation",
      "owner": "platform",
      "directory": "packages/foundation",
      "chineseName": "基础设施",
      "description": "Security, state, configuration, and governance primitives.",
      "publicApi": [
        "#lico/foundation/*"
      ]
    },
    {
      "id": "agents",
      "kind": "domain",
      "owner": "platform",
      "directory": "packages/agents",
      "description": "Agent gateway and local agent workspace primitives.",
      "publicApi": [
        "#lico/agents/*"
      ]
    },
    {
      "id": "capabilities",
      "kind": "domain",
      "owner": "platform",
      "directory": "packages/capabilities",
      "description": "Operation Permission and capability catalog.",
      "publicApi": [
        "#lico/capabilities/*"
      ]
    },
    {
      "id": "protocols-mcp",
      "kind": "protocol",
      "owner": "platform",
      "directory": "packages/protocols/mcp",
      "description": "MCP gateway adapter.",
      "publicApi": [
        "#lico/protocols/*"
      ]
    },
    {
      "id": "server-runtime",
      "kind": "runtime",
      "owner": "platform",
      "directory": "packages/server-runtime",
      "description": "Server composition runtime.",
      "publicApi": [
        "#lico/server-runtime/*"
      ]
    },
    {
      "id": "ui-console",
      "kind": "ui",
      "owner": "frontend",
      "directory": "packages/ui-console",
      "description": "Shared console domain services and portable UI contracts.",
      "publicApi": [
        "#lico/ui-console/*",
        "#lico/ui-console/bridge-http",
        "#lico/ui-console/page-refresh",
        "#lico/ui-console/rpc-client",
        "#lico/ui-console/error-message",
        "#lico/ui-console/binary-checkbox",
        "#lico/ui-console/workspaces-view-context",
        "#lico/ui-console/server-console-shell-context",
        "#lico/ui-console/console-format-utils",
        "#lico/ui-console/console-client-display-utils",
        "#lico/ui-console/option-bar",
        "#lico/ui-console/status-pill"
      ]
    },
    {
      "id": "server-app",
      "kind": "app",
      "owner": "platform",
      "directory": "apps/server",
      "description": "Node server process bootstrap.",
      "publicApi": []
    },
    {
      "id": "console-app",
      "kind": "app",
      "owner": "frontend",
      "directory": "apps/console",
      "description": "Vue console application.",
      "publicApi": []
    }
  ]
}
