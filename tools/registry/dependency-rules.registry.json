{
  "$schema": "./schema/dependency-rule.schema.json",
  "version": "v0.1.0",
  "layers": [
    {
      "id": "contracts",
      "name": "Contracts",
      "directory": "packages/contracts",
      "allowedDependsOn": [
        "foundation"
      ],
      "forbiddenDependsOn": [
        "agents",
        "capabilities",
        "protocols",
        "server-runtime",
        "ui-console",
        "apps",
        "plugins",
        "tools"
      ]
    },
    {
      "id": "foundation",
      "name": "Foundation",
      "directory": "packages/foundation",
      "allowedDependsOn": [
        "contracts"
      ],
      "forbiddenDependsOn": [
        "agents",
        "capabilities",
        "protocols",
        "server-runtime",
        "ui-console",
        "plugins",
        "tools"
      ]
    },
    {
      "id": "agents",
      "name": "Agents",
      "directory": "packages/agents",
      "allowedDependsOn": [
        "contracts",
        "foundation",
        "protocols"
      ],
      "forbiddenDependsOn": [
        "capabilities",
        "server-runtime",
        "ui-console",
        "apps",
        "plugins",
        "tools"
      ]
    },
    {
      "id": "capabilities",
      "name": "Capabilities",
      "directory": "packages/capabilities",
      "allowedDependsOn": [
        "contracts",
        "foundation",
        "protocols"
      ],
      "forbiddenDependsOn": [
        "agents",
        "server-runtime",
        "ui-console",
        "apps",
        "plugins",
        "tools"
      ]
    },
    {
      "id": "protocols",
      "name": "Protocols",
      "directory": "packages/protocols",
      "allowedDependsOn": [
        "contracts",
        "foundation"
      ],
      "forbiddenDependsOn": [
        "agents",
        "capabilities",
        "server-runtime",
        "ui-console",
        "apps",
        "plugins",
        "tools"
      ]
    },
    {
      "id": "server-runtime",
      "name": "Server Runtime",
      "directory": "packages/server-runtime",
      "allowedDependsOn": [
        "contracts",
        "foundation",
        "agents",
        "capabilities",
        "protocols"
      ],
      "forbiddenDependsOn": [
        "ui-console",
        "apps",
        "plugins",
        "tools"
      ]
    },
    {
      "id": "ui-console",
      "name": "UI Console Adapter",
      "directory": "packages/ui-console",
      "allowedDependsOn": [
        "contracts",
        "foundation",
        "agents",
        "capabilities",
        "protocols"
      ],
      "forbiddenDependsOn": [
        "server-runtime",
        "apps",
        "plugins",
        "tools"
      ]
    },
    {
      "id": "apps",
      "name": "Apps",
      "directory": "apps",
      "allowedDependsOn": [
        "contracts",
        "foundation",
        "server-runtime",
        "protocols",
        "ui-console"
      ],
      "forbiddenDependsOn": [
        "agents",
        "capabilities",
        "plugins",
        "tools"
      ]
    },
    {
      "id": "plugin-console",
      "name": "Plugin Console Adapters",
      "directory": "plugins/**/console",
      "allowedDependsOn": [
        "contracts",
        "foundation",
        "agents",
        "capabilities",
        "protocols",
        "server-runtime",
        "ui-console",
        "plugins"
      ],
      "forbiddenDependsOn": [
        "apps",
        "tools"
      ]
    },
    {
      "id": "plugin-verifiers",
      "name": "Plugin Verifiers",
      "directory": "plugins/*/verifiers",
      "allowedDependsOn": [
        "contracts",
        "foundation",
        "agents",
        "capabilities",
        "protocols",
        "server-runtime",
        "ui-console",
        "apps",
        "plugins",
        "tools"
      ],
      "forbiddenDependsOn": []
    },
    {
      "id": "plugin-tests",
      "name": "Plugin Tests",
      "directory": "plugins/*/tests",
      "allowedDependsOn": [
        "contracts",
        "foundation",
        "agents",
        "capabilities",
        "protocols",
        "server-runtime",
        "ui-console",
        "apps",
        "plugins",
        "tools"
      ],
      "forbiddenDependsOn": []
    },
    {
      "id": "plugins",
      "name": "Optional Plugins",
      "directory": "plugins",
      "allowedDependsOn": [
        "contracts",
        "foundation",
        "agents",
        "capabilities",
        "protocols",
        "server-runtime",
        "ui-console"
      ],
      "forbiddenDependsOn": [
        "apps",
        "tools"
      ]
    },
    {
      "id": "tools",
      "name": "Repository Tooling",
      "directory": "tools",
      "allowedDependsOn": [
        "contracts",
        "foundation",
        "agents",
        "capabilities",
        "protocols",
        "server-runtime",
        "ui-console",
        "apps",
        "plugins",
        "plugin-console",
        "plugin-verifiers",
        "plugin-tests"
      ],
      "forbiddenDependsOn": []
    }
  ],
  "constraints": [
    {
      "id": "ui-console-stateful-providers-require-composition",
      "description": "UI console executors consume stateful runtime providers through explicit ports assembled by the server composition boundary.",
      "fromPattern": "packages/ui-console/src/**",
      "fromLayers": [
        "ui-console"
      ],
      "specifierKinds": [
        "relative",
        "package",
        "package-import"
      ],
      "forbiddenTargets": [
        "packages/agents/src/workspace-governance/**",
        "packages/foundation/src/observability/readiness-baseline/**",
        "packages/foundation/src/observability/executive-report.ts",
        "packages/foundation/src/observability/sample-capability-pack.ts",
        "packages/foundation/src/security/security-alerts.ts"
      ],
      "severity": "error"
    },
    {
      "id": "http-controllers-require-composed-security-ports",
      "description": "HTTP controllers consume security ports supplied by composition and do not create security authorities.",
      "fromPattern": "packages/protocols/http/controllers/**",
      "fromLayers": [
        "protocols"
      ],
      "specifierKinds": [
        "relative",
        "package",
        "package-import"
      ],
      "forbiddenTargets": [
        "packages/foundation/src/security/security-permissions-provider.ts"
      ],
      "severity": "error"
    },
    {
      "id": "server-runtime-cross-layer-wiring-requires-composition",
      "description": "Server runtime state, jobs, routing, and module runtime must receive domain and protocol implementations from the composition boundary.",
      "fromPattern": "packages/server-runtime/src/**",
      "excludedFromPatterns": [
        "packages/server-runtime/src/composition/**"
      ],
      "fromLayers": [
        "server-runtime"
      ],
      "specifierKinds": [
        "relative",
        "package",
        "package-import"
      ],
      "forbiddenTargets": [
        "packages/agents/**",
        "packages/capabilities/**",
        "packages/protocols/**"
      ],
      "severity": "error"
    },
    {
      "id": "plugin-production-relative-imports-use-public-packages",
      "description": "Plugin production sources must consume public package exports instead of relative monorepo implementation paths.",
      "fromPattern": "plugins/**",
      "fromLayers": [
        "plugins",
        "plugin-console"
      ],
      "specifierKinds": [
        "relative"
      ],
      "forbiddenTargets": [
        "apps/**",
        "packages/**",
        "tools/**"
      ],
      "severity": "error"
    }
  ],
  "exceptions": []
}
