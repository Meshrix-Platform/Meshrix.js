{
  "$schema": "./schema/release-authority-baseline.schema.json",
  "version": "v0.0.1:registry:release-authority-baseline-1",
  "policy": {
    "inspectAuthoritiesDirectly": true,
    "neverImportGeneratedReportStatus": true,
    "placeholderReportsCannotSatisfyReleaseFacts": true,
    "doNotDeleteLockdownBeforePositivePath": true,
    "notes": [
      "This baseline inventories live release authorities and remaining migration targets.",
      "Register only recomputable positive evidence as release-ready.",
      "Generated projections are owned by generatorOwnership and must stay in sync with authority sources.",
      "Live catalogs are discovered from catalogAuthorities; migrationInventory classifies retained positive paths versus lockdown/static-only authorities to remove later."
    ]
  },
  "catalogAuthorities": {
    "commands": "tools/server-scripts/lib/platform-acceptance-command-catalog.ts",
    "reports": "tools/server-scripts/lib/platform-acceptance-command-catalog.ts",
    "capabilities": "tools/registry/capability-acceptance.registry.json",
    "checkpoints": "tools/registry/capability-acceptance-checkpoints",
    "reducerInputs": "tools/server-scripts/lib/platform-acceptance-reducer.ts",
    "requiredReportSpecs": "tools/server-scripts/lib/required-report-validator.ts",
    "acceptanceStandards": "tools/registry/release-acceptance-standards.registry.json",
    "generatedProjections": "tools/registry/release-authority-baseline.registry.json#generatorOwnership",
    "sourceAuthorities": "tools/registry/fact-source-authority.registry.json"
  },
  "generatorOwnership": [
    {
      "id": "capability-acceptance-definitions",
      "generator": "tools/generators/generate-capability-acceptance-definitions.ts",
      "authorityPath": "tools/registry/capability-acceptance-checkpoints",
      "projectionPaths": [
        "tools/registry/capability-acceptance.registry.json",
        "packages/foundation/src/workflow/state-machine/definitions/acceptance"
      ]
    },
    {
      "id": "state-machine-integrity-registry",
      "generator": "tools/generators/generate-state-machine-integrity-registry.ts",
      "authorityPath": "packages/foundation/src/workflow/state-machine/definitions",
      "projectionPaths": [
        "tools/registry/state-machines/state-machine-integrity.registry.json"
      ]
    },
    {
      "id": "operation-artifacts",
      "generator": "tools/generators/generate-operation-artifacts.ts",
      "authorityPath": "packages/contracts/src/operations/operation-registry.ts",
      "projectionPaths": [
        "tools/registry/operations/operations.registry.json",
        "tools/registry/capabilities/capabilities.registry.json"
      ]
    },
    {
      "id": "state-machine-docs-projection",
      "generator": "tools/generators/generate-state-machine-docs.ts",
      "authorityPath": "tools/registry/state-machines/state-machine-integrity.registry.json",
      "projectionPaths": [
        "docs/architecture/STATE-MACHINES.md",
        "packages/foundation/src/workflow/state-machine/definitions/README.md"
      ]
    },
    {
      "id": "architecture-diagram-digests",
      "generator": "tools/generators/generate-architecture-diagram-digests.ts",
      "authorityPath": "packages/contracts/src/modules/manifest.ts",
      "projectionPaths": [
        "docs/architecture/MESHRIX-SYSTEM-ARCHITECTURE.html",
        "docs/architecture/MESHRIX-SERVICE-CAPABILITY-ARCHITECTURE.html"
      ]
    }
  ],
  "migrationInventory": {
    "retainedPositiveForwarding": [
      {
        "id": "release-acceptance-standards-positive-path",
        "classification": "retained-positive-forwarding",
        "description": "The acceptance-standards registry remains the sole authority for the mandatory functional-complete and release-deployment claims and the downstream optional real-machine claim.",
        "authorityPaths": [
          "tools/registry/release-acceptance-standards.registry.json",
          "tools/server-scripts/verify-release-acceptance-standards.ts"
        ],
        "assertions": [
          "Functional completeness is a mandatory project release gate.",
          "Release-deployment verification is a mandatory project release gate consuming a functional-complete receipt for the exact candidate.",
          "Real-machine verification consumes a candidate-bound functional receipt.",
          "Real-machine results cannot block or revoke functional completeness."
        ]
      },
      {
        "id": "fact-source-authority-positive-path",
        "classification": "retained-positive-forwarding",
        "description": "Fact-source authority registry and verifier remain the positive path for release facts.",
        "authorityPaths": [
          "tools/registry/fact-source-authority.registry.json",
          "tools/verifiers/registry-fact-source-authority.ts"
        ],
        "assertions": [
          "Every required release fact maps to a declared source authority.",
          "Generated report status is never imported as an authority.",
          "Placeholder or static-only authorities cannot satisfy required release facts."
        ]
      },
      {
        "id": "platform-acceptance-reducer-positive-path",
        "classification": "retained-positive-forwarding",
        "description": "Functional acceptance catalogs and reducer remain the positive path for mandatory command/report readiness.",
        "authorityPaths": [
          "tools/server-scripts/lib/platform-acceptance-command-catalog.ts",
          "tools/server-scripts/lib/platform-acceptance-reducer.ts",
          "tools/server-scripts/lib/required-report-validator.ts",
          "tools/server-scripts/lib/release-evidence-readiness.ts"
        ],
        "assertions": [
          "Every acceptance command is registered in the command catalog.",
          "Every required report is owned by exactly one command and registered in required-report specs.",
          "Reducer inputs are derived only from registered catalogs and live evidence."
        ]
      },
      {
        "id": "capability-acceptance-positive-path",
        "classification": "retained-positive-forwarding",
        "description": "Capability acceptance checkpoints remain the positive path for capability readiness machines.",
        "authorityPaths": [
          "tools/registry/capability-acceptance-checkpoints",
          "tools/registry/capability-acceptance.registry.json",
          "tools/generators/generate-capability-acceptance-definitions.ts"
        ],
        "assertions": [
          "Every capability checkpoint is registered.",
          "Checkpoint evidence must reference live authority, not decorative placeholders."
        ]
      }
    ],
    "removeLaterLockdownOrStaticOnly": [
      {
        "id": "security-local-stdio-lockdown",
        "classification": "lockdown",
        "description": "Local stdio lockdown verifier asserts absence of unsafe local stdio surfaces; remove after positive governed stdio path is the only remaining authority.",
        "authorityPaths": [
          "tools/server-scripts/verify-security-local-stdio-lockdown.ts"
        ],
        "consumers": [
          "tools/server-scripts/production-readiness-gate.ts",
          "tools/server-scripts/verify-security-hardening.ts",
          "docs/functionality/SECURITY-AUTHORIZATION.md"
        ],
        "replacementAuthority": "tools/registry/fact-source-authority.registry.json",
        "status": "present-must-remove-after-positive-path",
        "liveCommandIds": [],
        "liveReportPaths": []
      },
      {
        "id": "static-only-placeholder-report-success",
        "classification": "static-only",
        "description": "Any static or placeholder report that claims releaseReady without live authority evidence must remain inventoried as forbidden until deleted.",
        "authorityPaths": [
          "tools/server-scripts/lib/required-report-validator.ts",
          "tools/server-scripts/lib/release-evidence-readiness.ts"
        ],
        "consumers": [
          "tools/server-scripts/lib/platform-acceptance-reducer.ts",
          "tools/verifiers/registry-release-authority-baseline.ts",
          "tests/vitest/server/release-authority-baseline.test.ts"
        ],
        "replacementAuthority": "tools/registry/fact-source-authority.registry.json",
        "status": "present-must-remove-after-positive-path",
        "liveCommandIds": [],
        "liveReportPaths": []
      }
    ]
  }
}
