{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.meshrix.example/schemas/release-definition.schema.json",
  "title": "Meshrix.js Release Definition",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "product",
    "release",
    "packages",
    "container",
    "acceptance",
    "prepublication",
    "github",
    "localVerification"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "product": { "const": "Meshrix.js" },
    "release": {
      "type": "object",
      "required": ["version", "tag", "channel"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
        "channel": { "enum": ["stable", "next"] }
      },
      "additionalProperties": false
    },
    "packages": {
      "type": "object",
      "required": ["manifests"],
      "properties": {
        "manifests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+/package\\.json$|^package\\.json$" }
        }
      },
      "additionalProperties": false
    },
    "container": {
      "type": "object",
      "required": ["target", "platforms"],
      "properties": {
        "target": { "const": "runtime-ui" },
        "platforms": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["linux/amd64", "linux/arm64"] }
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": ["profile", "commandId", "requiredClaim", "standardsRegistry"],
      "properties": {
        "profile": { "const": "enterprise-single-node" },
        "commandId": { "const": "platform-acceptance" },
        "requiredClaim": { "const": "functional-complete" },
        "standardsRegistry": {
          "const": "tools/registry/release-acceptance-standards.registry.json"
        }
      },
      "additionalProperties": false
    },
    "prepublication": {
      "type": "object",
      "required": ["requiredClaim", "candidateReceipt", "artifacts"],
      "properties": {
        "requiredClaim": {
          "const": "upstream-publishing-prepublication-passed"
        },
        "candidateReceipt": {
          "const": "build/reports/upstream-service-publishing-candidate.json"
        },
        "artifacts": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^build/reports/(?:upstream-service-publishing(?:\\.json|\\.html|/upstream-service-basic-config\\.json|/screenshots/[a-z0-9][a-z0-9-]*\\.png)|release-journey\\.json)$"
          }
        }
      },
      "additionalProperties": false
    },
    "github": {
      "type": "object",
      "required": ["environment", "nodeVersion"],
      "properties": {
        "environment": { "const": "release-candidate" },
        "nodeVersion": { "type": "string", "pattern": "^24\\.[0-9]+\\.[0-9]+$" }
      },
      "additionalProperties": false
    },
    "localVerification": {
      "type": "object",
      "required": ["engine", "evidenceAuthority"],
      "properties": {
        "engine": { "const": "podman" },
        "evidenceAuthority": { "const": "local-only" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
