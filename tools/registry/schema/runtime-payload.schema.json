{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.meshrix.example/registry/schema/runtime-payload.schema.json",
  "title": "Runtime Payloads Registry",
  "description": "Canonical list of heavy runtime payloads excluded from the npm package and downloaded at runtime.",
  "type": "object",
  "required": ["version", "payloads"],
  "properties": {
    "$schema": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date" },
    "version": { "type": "string", "pattern": "^v?\\d+\\.\\d+\\.\\d+$" },
    "payloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "requiredFor": {
            "type": "array",
            "items": { "type": "string" }
          },
          "providers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "protocolDeferred": {
            "type": "array",
            "items": { "type": "string" }
          },
          "minimalProfileSkipped": {
            "type": "boolean"
          },
          "pattern": { "type": "string" },
          "packageExclusion": { "type": "string" },
          "downloadedAtRuntime": { "type": "boolean" },
          "mayBeAbsentInSource": { "type": "boolean" },
          "severityIfMissing": { "type": "string", "enum": ["warning", "info", "error"] }
        }
      }
    }
  }
}
