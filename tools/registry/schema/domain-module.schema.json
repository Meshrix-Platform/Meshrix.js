{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.meshrix.example/registry/schema/domain-module.schema.json",
  "title": "Domain Package Manifest",
  "description": "Verifiable ownership manifest for a domain package's current source roots, dependencies, public API, and executable test evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "kind",
    "owner",
    "directory",
    "description",
    "publicApi",
    "dependsOn",
    "sourceOwnership"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "domain-module\\.schema\\.json$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "kind": {
      "const": "domain"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "directory": {
      "type": "string",
      "pattern": "^packages/[a-z][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "publicApi": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^#meshrix/[a-z][a-z0-9-]*/\\*$"
      }
    },
    "dependsOn": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "sourceOwnership": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature", "path", "fileCount", "testSuites"],
        "properties": {
          "feature": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^src/[^/]+$"
          },
          "fileCount": {
            "type": "integer",
            "minimum": 1
          },
          "testSuites": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9*][a-z0-9.*-]*$"
            }
          }
        }
      }
    }
  }
}
