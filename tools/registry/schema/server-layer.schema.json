{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.licomesh.example/registry/schema/server-layer.schema.json",
  "title": "Server Layer Registry",
  "description": "Canonical list of server directory layers with dependency constraints.",
  "type": "object",
  "required": ["$schema", "version", "layers"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["directory", "layer", "role", "allowedDependsOn", "forbiddenDependsOn"],
        "properties": {
          "directory": { "type": "string" },
          "layer": { "type": "string" },
          "role": { "type": "string" },
          "allowedDependsOn": {
            "type": "array",
            "items": { "type": "string" }
          },
          "forbiddenDependsOn": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
