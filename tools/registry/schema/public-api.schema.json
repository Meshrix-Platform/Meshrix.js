{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.meshrix.example/registry/schema/public-api.schema.json",
  "title": "Public API Registry",
  "description": "Canonical list of every #meshrix public import alias and its implementation path.",
  "type": "object",
  "required": ["$schema", "version", "aliases"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alias", "targetPath", "status"],
        "properties": {
          "alias": { "type": "string", "pattern": "^#meshrix/" },
          "targetPath": { "type": "string" },
          "status": { "type": "string", "enum": ["active"] },
          "domainPackage": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date" },
          "exportedSymbols": { "type": "array", "items": { "type": "string" } },
          "owner": { "type": "string" },
          "layer": { "type": "string" },
          "privatePathPatterns": { "type": "array", "items": { "type": "string" } },
          "privatePathAllowedConsumers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "publicResources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resourceId", "path"],
        "properties": {
          "resourceId": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    }
  }
}
