{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.licomesh.example/registry/schema/operation.schema.json",
  "title": "Operation Registry",
  "description": "Canonical operation registry used to generate HTTP routes, RPC methods, capabilities, and OpenAPI artifacts.",
  "type": "object",
  "required": ["$schema", "version", "operations"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string" },
    "canonicalSource": { "type": "boolean" },
    "canonicalSourcePath": { "type": "string" },
    "description": { "type": "string" },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "feature", "http", "rpc", "requiredScopes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "label": { "type": "string" },
          "feature": { "type": "string", "minLength": 1 },
          "readOnly": { "type": "boolean" },
          "public": { "type": "boolean" },
          "risk": {
            "type": "string",
            "enum": ["read_only", "safe_write", "repair_write", "destructive"]
          },
          "requiredScopes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "resourceContext": { "type": "object" },
          "http": {
            "type": "object",
            "required": ["method", "path"],
            "properties": {
              "method": { "type": "string" },
              "path": { "type": "string" },
              "query": {
                "type": "array",
                "items": { "type": "object" }
              },
              "localInForwardMode": { "type": "boolean" }
            },
            "additionalProperties": true
          },
          "rpc": {
            "type": "object",
            "required": ["method"],
            "properties": {
              "method": { "type": "string" },
              "body": { "type": "string" }
            },
            "additionalProperties": true
          },
          "cli": { "type": "object" },
          "target": { "type": "object" },
          "otel": { "type": "object" },
          "auditPolicy": { "type": "object" },
          "audit": { "type": "object" },
          "log": { "type": "object" },
          "inputSchema": { "type": "object" },
          "safety": { "type": "object" },
          "concurrency": { "type": "object" },
          "aspects": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
