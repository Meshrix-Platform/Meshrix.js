{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.meshrix.example/schemas/release-acceptance-standards.schema.json",
  "title": "Meshrix.js Release Acceptance Standards",
  "type": "object",
  "required": ["$schema", "version", "functionalCompleteness", "realMachineVerification"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "v0.0.1:registry:release-acceptance-standards-1" },
    "functionalCompleteness": {
      "type": "object",
      "required": ["claim", "requiredForRelease", "command", "plan", "covers"],
      "properties": {
        "claim": { "const": "functional-complete" },
        "requiredForRelease": { "const": true },
        "command": { "const": "npm run verify:acceptance" },
        "plan": { "const": "end-to-end-release/functional-release-acceptance" },
        "covers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "realMachineVerification": {
      "type": "object",
      "required": [
        "claim",
        "requiredForRelease",
        "requiresClaim",
        "command",
        "workflow",
        "targets"
      ],
      "properties": {
        "claim": { "const": "real-machine-verified" },
        "requiredForRelease": { "const": false },
        "requiresClaim": { "const": "functional-complete" },
        "command": { "const": "npm run verify:real-machine" },
        "workflow": { "const": ".github/workflows/real-machine-validation.yml" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id", "system", "environment", "mode", "simulationCommand"],
            "properties": {
              "id": {
                "enum": [
                  "native-linux-x64",
                  "native-linux-arm64",
                  "native-macos-arm64",
                  "native-windows-x64",
                  "public-cloud-single-node",
                  "clean-host-recovery"
                ]
              },
              "system": {
                "enum": [
                  "linux-x64",
                  "linux-arm64",
                  "macos-arm64",
                  "windows-x64",
                  "declared-linux"
                ]
              },
              "environment": {
                "enum": ["native-host", "public-cloud", "independent-recovery-host"]
              },
              "mode": { "const": "optional" },
              "simulationCommand": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
