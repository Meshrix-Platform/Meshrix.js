{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.licomesh.example/schemas/fact-source-authority.schema.json",
  "title": "Fact Source Authority Registry",
  "type": "object",
  "required": ["$schema", "version", "policy", "authorities"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "policy": {
      "type": "object",
      "required": ["singleAuthority", "uniqueFactKeys", "projectionOnlyReports", "noDocumentOverrides"],
      "properties": {
        "singleAuthority": { "type": "boolean" },
        "uniqueFactKeys": { "type": "boolean" },
        "projectionOnlyReports": { "type": "boolean" },
        "noDocumentOverrides": { "type": "boolean" },
        "notes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "factKey", "domain", "authorityPath", "authorityRole", "consumerPaths", "verification", "nonAuthorityBoundaries"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "factKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
          },
          "domain": { "type": "string", "minLength": 1 },
          "authorityPath": { "type": "string", "minLength": 1 },
          "authorityRole": { "type": "string", "minLength": 1 },
          "projectionPaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "consumerPaths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "verification": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "nonAuthorityBoundaries": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
