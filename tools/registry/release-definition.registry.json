{
  "$schema": "./schema/release-definition.schema.json",
  "version": "v0.0.1:registry:release-definition-1",
  "product": "Meshrix",
  "release": {
    "version": "0.0.1",
    "tag": "v0.0.1",
    "channel": "stable"
  },
  "packages": {
    "manifests": [
      "package.json",
      "packages/contracts/package.json",
      "packages/foundation/package.json",
      "packages/agents/package.json",
      "packages/capabilities/package.json",
      "packages/protocols/package.json",
      "packages/server-runtime/package.json",
      "packages/ui-console/package.json",
      "apps/server/package.json",
      "apps/console/package.json",
      "packages/protocols/mcp/adapter/gateway-installer/package.json"
    ]
  },
  "container": {
    "target": "runtime-ui",
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  },
  "acceptance": {
    "profile": "enterprise-single-node",
    "commandId": "platform-acceptance",
    "requiredClaim": "functional-complete",
    "standardsRegistry": "tools/registry/release-acceptance-standards.registry.json"
  },
  "prepublication": {
    "requiredClaim": "upstream-publishing-prepublication-passed",
    "candidateReceipt": "build/reports/upstream-service-publishing-candidate.json",
    "artifacts": [
      "build/reports/upstream-service-publishing.json",
      "build/reports/release-journey.json",
      "build/reports/upstream-service-publishing/upstream-service-basic-config.json",
      "build/reports/upstream-service-publishing.html",
      "build/reports/upstream-service-publishing/screenshots/console-authenticated.png",
      "build/reports/upstream-service-publishing/screenshots/console-upstream-basic-config.png",
      "build/reports/upstream-service-publishing/screenshots/console-upstream-operation-config.png",
      "build/reports/upstream-service-publishing/screenshots/console-upstream-published.png",
      "build/reports/upstream-service-publishing/screenshots/console-published-tool.png",
      "build/reports/upstream-service-publishing/screenshots/console-token-authorization-pending.png",
      "build/reports/upstream-service-publishing/screenshots/console-token-authorization-consumed.png",
      "build/reports/upstream-service-publishing/screenshots/console-operation-approval-pending.png",
      "build/reports/upstream-service-publishing/screenshots/console-operation-approval-completed.png",
      "build/reports/upstream-service-publishing/screenshots/console-downstream-mcp-call.png"
    ]
  },
  "github": {
    "environment": "release-candidate",
    "nodeVersion": "24.16.0"
  },
  "localVerification": {
    "engine": "podman",
    "evidenceAuthority": "local-only"
  }
}
