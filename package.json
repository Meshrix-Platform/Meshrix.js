  "//architecture-governance": {
    "description": "Canonical architecture governance — production code resolves through apps, packages, content, tools, and tests.",
    "lastUpdated": "2026-06-25",
    "canonicalSourceRoots": [
      "apps/",
      "packages/",
      "content/",
      "services/",
      "plugins/",
      "tools/",
      "tests/",
      "docs/"
    ],
    "prohibitedSourceRoots": [
      "server/",
      "server-web/",
      "client-cli/",
      "client-gui/",
      "skills/",
      "scripts/"
    ],
    "prohibitedRootPolicy": "non-current top-level roots are prohibited as implementation or documentation structure; product behavior and project docs must use canonical functional roots"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.3.0"
  },
  "bin": {
    "meshrix": "dist/apps/server/bin/meshrix.js",
    "meshrix-server": "dist/tools/server-scripts/start-server.js"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/start-server.ts --profile core --dev",
    "start:dev": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts start dev",
    "stop:dev": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts stop dev",
    "restart:dev": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts restart dev",
    "start:server": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts start server",
    "stop:server": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts stop server",
    "restart:server": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts restart server",
    "start:console": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts start console",
    "stop:console": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts stop console",
    "restart:console": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts restart console",
    "start:compose": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts start compose",
    "stop:compose": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts stop compose",
    "restart:compose": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts restart compose",
    "start:compose:ui": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts start compose-ui",
    "stop:compose:ui": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts stop compose-ui",
    "restart:compose:ui": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts restart compose-ui",
    "start:offline": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts start offline",
    "stop:offline": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts stop offline",
    "restart:offline": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/instance-lifecycle.ts restart offline",
    "bootstrap:native:orb": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/native-orb-bootstrap.ts",
    "deploy:native:orb": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/native-orb-deploy.ts",
    "start:optional": "cross-env NODE_OPTIONS=--conditions=source node tools/optional-startup/start.ts",
    "pack:offline": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/offline-delivery-pack.ts",
    "build": "npm run build:node && npm run build:web",
    "typecheck": "npm run typecheck:node && npm run typecheck:test && npm run typecheck:web",
    "test": "cross-env NODE_OPTIONS=--conditions=source node tests/run.ts --profile core-public --continue-on-failure",
    "test:security": "cross-env NODE_OPTIONS=--conditions=source node tests/run.ts --profile security-public",
    "test:audit": "cross-env NODE_OPTIONS=--conditions=source node tests/run.ts --profile audit-public --continue-on-failure --report build/test-reports/audit-public.json",
    "test:audit:stage": "cross-env NODE_OPTIONS=--conditions=source node tests/run.ts --continue-on-failure",
    "test:audit:reduce": "cross-env NODE_OPTIONS=--conditions=source node tools/server-scripts/reduce-stable-audit-stages.ts",
    "test:smoke": "cross-env NODE_OPTIONS=--conditions=source node tests/run.ts --profile smoke-public",
    "test:list": "cross-env NODE_OPTIONS=--conditions=source node tests/run.ts --list",
    "test:functional:frontend": "npm run vitest -- tests/vitest/console --maxWorkers=2",
    "test:functional:backend:server": "cross-env NODE_OPTIONS=--conditions=source node tests/run-functional-backend-server.ts",
    "test:functional:backend:worker-thread": "npm run vitest -- tests/vitest/server/operation-audit-retention.test.ts --maxWorkers=1",
    "test:functional:backend:unit": "npm run vitest -- tests/unit/routing tests/unit/security tests/unit/serialization --maxWorkers=2",
    "test:functional:backend:contract": "npm run vitest -- tests/contract/domains tests/contract/protocols --maxWorkers=2",
    "test:interface": "npm run vitest -- tests/acceptance",
    "test:platform:runtime-plugins": "npm run verify:local-runtime-plugins && npm run verify:local-extension-package-closure",
    "verify": "npm test",
