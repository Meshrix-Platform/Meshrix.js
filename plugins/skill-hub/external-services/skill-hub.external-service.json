      "transport": {
        "type": "http",
        "method": "POST",
        "path": "/v1/operations/skill_hub.permission.request"
      },
      "requiredScopes": [
        "workspace:write"
      ],
      "risk": "safe_write",
      "inputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "operationId": "skill_hub.permission.grant",
      "label": "Grant Skill Hub permission",
      "transport": {
        "type": "http",
        "method": "POST",
        "path": "/v1/operations/skill_hub.permission.grant"
      },
      "requiredScopes": [
        "workspace:maintain"
      ],
      "risk": "repair_write",
      "inputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    }
  ],
  "healthCheck": {
    "type": "http",
    "method": "GET",
    "path": "/readyz"
  },
  "metadata": {
    "pluginId": "skill-hub",
    "deployment": "independent-service-required"
  }
}
