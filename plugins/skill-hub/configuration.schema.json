{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshrix.io/schemas/plugins/skill-hub/configuration.schema.json",
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean" },
    "service": {
      "type": "object",
      "properties": {
        "serviceRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        }
      },
      "required": ["serviceRef", "timeoutMs"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "enabled": { "const": true } },
        "required": ["enabled"]
      },
      "then": { "required": ["service"] },
      "else": { "not": { "required": ["service"] } }
    }
  ],
  "additionalProperties": false
}
