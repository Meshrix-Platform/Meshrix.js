{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshrix.io/schemas/plugins/shared-space/configuration.schema.json",
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean" },
    "modules": {
      "type": "object",
      "properties": {
        "localDirectory": { "const": true },
        "controlledSandbox": { "const": true }
      },
      "required": ["localDirectory", "controlledSandbox"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "enabled": { "const": true } },
        "required": ["enabled"]
      },
      "then": { "required": ["modules"] },
      "else": { "not": { "required": ["modules"] } }
    }
  ],
  "additionalProperties": false
}
