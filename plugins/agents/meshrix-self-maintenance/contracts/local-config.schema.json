{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshrix.local/schema/agent-self-maintenance-local-config.schema.json",
  "title": "Meshrix.js Agent Self-Maintenance Local Configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "enabledRevision",
    "targets",
    "strategies",
    "schedules",
    "runbooks",
    "budgets",
    "operationAllowlist",
    "resourceAllowlist",
    "workspaceSelectors",
    "credentialRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "v0.0.1:meshrix-self-maintenance:local-config-1"
    },
    "enabledRevision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "cron"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "cron": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "runbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "steps"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["operationId"],
              "properties": {
                "operationId": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "budgets": {
      "type": "object",
      "required": ["maxConcurrentCalls", "maxCallsPerDay", "maxCostUnitsPerDay"],
      "properties": {
        "maxConcurrentCalls": { "type": "integer", "minimum": 1 },
        "maxCallsPerDay": { "type": "integer", "minimum": 1 },
        "maxCostUnitsPerDay": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "operationAllowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9._-]*$"
      },
      "uniqueItems": true
    },
    "resourceAllowlist": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "workspaceSelectors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "credentialRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ref"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
