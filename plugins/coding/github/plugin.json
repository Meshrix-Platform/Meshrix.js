{
  "schemaVersion": "v0.0.1:plugin:manifest-1",
  "id": "coding-github",
  "label": "GitHub Connector",
  "version": "0.0.1",
  "description": "Governed GitHub REST, MCP, Codespace provider, and GitHub-hosted skill installer contributions.",
  "defaultEnabled": false,
  "contributionMode": "selected",
  "dependencies": [],
  "hostCapabilities": [],
  "features": ["coding-github"],
  "operations": [
    "github.repository.get",
    "github.repository.contents.get",
    "github.repository.compare",
    "github.pullRequests.list",
    "github.pullRequests.createDraft",
    "github.pullRequests.review.create",
    "github.issues.comment.create",
    "github.actions.workflowRuns.list",
    "github.mcp.tools.list",
    "github.mcp.tools.call",
    "codespace.providers.manifest",
    "codespace.repository.status",
    "codespace.tree.list",
    "codespace.file.read",
    "codespace.diff.read",
    "codespace.change.prepare",
    "codespace.change.upload",
    "codespace.review.comment",
    "codespace.review.requestChanges",
    "codespace.review.approve",
    "codespace.review.status.sync",
    "github.skills.install.plan",
    "github.skills.install.apply",
    "github.skills.install.rollback"
  ],
  "routes": [
    { "id": "github.repository.get.http", "path": "/api/coding-github/v1/repositories/:owner/:repo", "kind": "http" },
    { "id": "github.repository.contents.get.http", "path": "/api/coding-github/v1/repositories/:owner/:repo/contents", "kind": "http" },
    { "id": "github.repository.compare.http", "path": "/api/coding-github/v1/repositories/:owner/:repo/compare", "kind": "http" },
    { "id": "github.pullRequests.list.http", "path": "/api/coding-github/v1/repositories/:owner/:repo/pull-requests", "kind": "http" },
    { "id": "github.pullRequests.createDraft.http", "path": "/api/coding-github/v1/repositories/:owner/:repo/pull-requests/draft", "kind": "http" },
    { "id": "github.pullRequests.review.create.http", "path": "/api/coding-github/v1/repositories/:owner/:repo/pull-requests/:pullNumber/reviews", "kind": "http" },
    { "id": "github.issues.comment.create.http", "path": "/api/coding-github/v1/repositories/:owner/:repo/issues/:issueNumber/comments", "kind": "http" },
    { "id": "github.actions.workflowRuns.list.http", "path": "/api/coding-github/v1/repositories/:owner/:repo/actions/workflow-runs", "kind": "http" },
    { "id": "github.mcp.tools.list.http", "path": "/api/coding-github/v1/mcp/tools", "kind": "http" },
    { "id": "github.mcp.tools.call.http", "path": "/api/coding-github/v1/mcp/tools/call", "kind": "http" },
    { "id": "codespace.providers.manifest.http", "path": "/api/coding-github/v1/codespace/providers/manifest", "kind": "http" },
    { "id": "codespace.repository.status.http", "path": "/api/coding-github/v1/codespace/repository/status", "kind": "http" },
    { "id": "codespace.tree.list.http", "path": "/api/coding-github/v1/codespace/tree", "kind": "http" },
    { "id": "codespace.file.read.http", "path": "/api/coding-github/v1/codespace/file", "kind": "http" },
    { "id": "codespace.diff.read.http", "path": "/api/coding-github/v1/codespace/diff", "kind": "http" },
    { "id": "codespace.change.prepare.http", "path": "/api/coding-github/v1/codespace/change/prepare", "kind": "http" },
    { "id": "codespace.change.upload.http", "path": "/api/coding-github/v1/codespace/change/upload", "kind": "http" },
    { "id": "codespace.review.comment.http", "path": "/api/coding-github/v1/codespace/review/comment", "kind": "http" },
    { "id": "codespace.review.requestChanges.http", "path": "/api/coding-github/v1/codespace/review/request-changes", "kind": "http" },
    { "id": "codespace.review.approve.http", "path": "/api/coding-github/v1/codespace/review/approve", "kind": "http" },
    { "id": "codespace.review.status.sync.http", "path": "/api/coding-github/v1/codespace/review/status", "kind": "http" },
    { "id": "github.skills.install.plan.http", "path": "/api/coding-github/v1/skills/install/plan", "kind": "http" },
    { "id": "github.skills.install.apply.http", "path": "/api/coding-github/v1/skills/install/apply", "kind": "http" },
    { "id": "github.skills.install.rollback.http", "path": "/api/coding-github/v1/skills/install/rollback", "kind": "http" }
  ],
  "mcpTools": [
    "meshrix.github.repository.get",
    "meshrix.github.repository.contents.get",
    "meshrix.github.repository.compare",
    "meshrix.github.pullRequests.list",
    "meshrix.github.pullRequests.createDraft",
    "meshrix.github.pullRequests.review.create",
    "meshrix.github.issues.comment.create",
    "meshrix.github.actions.workflowRuns.list",
    "meshrix.github.mcp.tools.list",
    "meshrix.github.mcp.tools.call",
    "meshrix.codespace.providers.manifest",
    "meshrix.codespace.repository.status",
    "meshrix.codespace.tree.list",
    "meshrix.codespace.file.read",
    "meshrix.codespace.diff.read",
    "meshrix.codespace.change.prepare",
    "meshrix.codespace.change.upload",
    "meshrix.codespace.review.comment",
    "meshrix.codespace.review.requestChanges",
    "meshrix.codespace.review.approve",
    "meshrix.codespace.review.status.sync",
    "meshrix.github.skills.install.plan",
    "meshrix.github.skills.install.apply",
    "meshrix.github.skills.install.rollback"
  ],
  "consoleEntries": ["admin.coding-github"],
  "stateMachines": ["github-skill-install.lifecycle"],
  "runtime": { "module": "./runtime.mjs" },
  "verifierHooks": [
    {
      "id": "coding-github-artifact-contract",
      "workloadKind": "plugin_verifier.coding_github_artifact_contract",
      "source": "verifiers/artifact-contract.mjs"
    }
  ]
}
