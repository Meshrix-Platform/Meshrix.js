{
  "schemaVersion": "v0.0.1:schema:definition-1",
  "kind": "meshrix.external-service.contract",
  "contractId": "coding-github.mcp.external-service",
  "displayName": "GitHub MCP contract",
  "description": "Closed contract for an operator-published read-only GitHub MCP service selected by plugin configuration.",
  "serviceSelection": {
    "configurationPath": "services.mcp.serviceRef",
    "operatorSupplied": true,
    "required": true
  },
  "upstreamContract": {
    "protocol": "mcp-streamable-http",
    "endpoint": {
      "operatorSupplied": true,
      "required": true,
      "allowedSchemes": ["https"]
    },
    "credential": {
      "operatorSupplied": true,
      "required": true,
      "custody": "secretRef"
    },
    "timeoutConfigurationPath": "services.mcp.timeoutMs",
    "fixedHeaders": {
      "X-MCP-Readonly": "true"
    }
  },
  "authorizationContract": {
    "boundary": "Operation Permission v1",
    "serviceAndCredentialBindingRequired": true,
    "readOnly": true
  },
  "tools": [
    {
      "operationId": "github.mcp.tools.list",
      "label": "List GitHub MCP tools",
      "transport": { "type": "mcp", "protocolMethod": "tools/list" },
      "requiredScopes": ["repo:read"],
      "risk": "read_only",
      "inputSchema": {
        "type": "object",
        "properties": {
          "protocolMethod": { "const": "tools/list" },
          "toolsets": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "page": { "type": "integer", "minimum": 1 },
          "perPage": { "type": "integer", "minimum": 1, "maximum": 100 },
          "cursor": { "type": "string", "maxLength": 512 }
        },
        "required": ["protocolMethod"],
        "additionalProperties": false
      }
    },
    {
      "operationId": "github.mcp.tools.call",
      "label": "Call a read-only GitHub MCP tool",
      "transport": { "type": "mcp", "protocolMethod": "tools/call" },
      "requiredScopes": ["repo:read"],
      "risk": "read_only",
      "inputSchema": {
        "type": "object",
        "properties": {
          "protocolMethod": { "const": "tools/call" },
          "toolName": { "type": "string", "minLength": 1, "maxLength": 128 },
          "arguments": { "type": "object" }
        },
        "required": ["protocolMethod", "toolName", "arguments"],
        "additionalProperties": false
      }
    }
  ],
  "healthCheck": {
    "type": "none"
  },
  "metadata": {
    "pluginId": "coding-github",
    "managedBy": "meshrix-plugins",
    "adoption": "operator-promote-required"
  }
}
