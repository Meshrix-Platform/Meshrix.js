{
  "schemaVersion": "v0.0.1:schema:definition-1",
  "kind": "meshrix.capability-package",
  "packageKind": "skill-installer",
  "pluginId": "coding-github",
  "provider": "github",
  "name": "skill-installer",
  "version": "0.0.1",
  "title": "GitHub Skill Installer",
  "description": "GitHub-hosted skill install plan/apply/rollback capability inside the single GitHub coding plugin.",
  "source": "external",
  "risk": "safe_write",
  "credentialContract": {
    "kind": "secretRef",
    "source": "operator-published-service",
    "required": true
  },
  "operations": [
    "github.skills.install.plan",
    "github.skills.install.apply",
    "github.skills.install.rollback"
  ],
  "providerConfig": {
    "mode": "external-service",
    "serviceBindingSource": "configuration.services.rest.serviceRef",
    "operatorSupplied": true,
    "credentialCustody": "host-secret-ref"
  },
  "promotion": {
    "defaultVisibility": "disabled",
    "previewDoesNotExecuteSkill": true,
    "applyRequiresTargetAdapter": true,
    "rollbackSnapshotRequired": true
  }
}
