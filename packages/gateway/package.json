{
  "name": "@meshrix/gateway",
  "version": "0.0.1",
  "description": "A programmable, policy-aware MCP gateway kernel for private deployments and embedded applications.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.3.0"
  },
  "dependencies": {
    "@meshrix/contracts": "0.0.1",
    "ajv": "^8.20.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
