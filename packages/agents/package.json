{
  "name": "@meshrix/agents",
  "version": "0.0.1",
  "description": "Meshrix.js agent library, collaboration, relay domain, memory/context contracts",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "type": "module",
  "dependencies": {
    "@meshrix/contracts": "0.0.1",
    "@meshrix/foundation": "0.0.1",
    "@meshrix/protocols": "0.0.1"
  },
  "exports": {
    "./workspace-contribution": {
      "types": "./dist/workspace-contribution/index.d.ts",
      "source": "./src/workspace-contribution/index.ts",
      "default": "./dist/workspace-contribution/index.js"
    },
    "./agent-workspace/agent-workspace-materialization-port": {
      "types": "./dist/agent-workspace/agent-workspace-materialization-port.d.ts",
      "source": "./src/agent-workspace/agent-workspace-materialization-port.ts",
      "default": "./dist/agent-workspace/agent-workspace-materialization-port.js"
    },
    "./agent-workspace/agent-workspace-materialization-brand": {
      "types": "./dist/agent-workspace/agent-workspace-materialization-brand.d.ts",
      "source": "./src/agent-workspace/agent-workspace-materialization-brand.ts",
      "default": "./dist/agent-workspace/agent-workspace-materialization-brand.js"
    },
    "./agent-workspace/agent-workspace-materialization": null,
    "./agent-workspace/agent-workspace-materialization-file-worker": null,
    "./*": {
      "types": "./dist/*.d.ts",
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
