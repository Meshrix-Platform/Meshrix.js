  "proofMappings": [
    {
      "obligationId": "PO-DEPLOYMENT-CONTAINER-FLOW",
      "method": "required_report",
      "params": {
        "command": "npm run server:verify:deployment-flow",
        "reportPath": "build/reports/deployment-container-flow.json"
      }
    },
    {
      "obligationId": "PO-DEPLOYMENT-PLUGIN-SELECTION",
      "method": "required_report",
      "params": {
        "command": "npm run verify:plugin-runtime",
        "reportPath": "build/reports/plugin-runtime.json"
      }
    },
    {
      "obligationId": "PO-DEPLOYMENT-STORAGE-RESTORE",
      "method": "required_report",
      "params": {
        "command": "node tools/server-scripts/verify-storage-production-restore-drill.mjs",
        "reportPath": "build/reports/storage-production-restore-drill/latest.json"
      }
    },
    {
      "obligationId": "PO-DEPLOYMENT-JOB-RECOVERY",
      "method": "required_report",
      "params": {
        "command": "node tools/server-scripts/verify-work-queue-conformance.mjs",
        "reportPath": "build/reports/work-queue/latest.json"
      }
    },
    {
      "obligationId": "PO-DEPLOYMENT-HEALTH",
      "method": "container_health_and_mcp_probe",
      "params": {
        "command": "npm run server:verify:deployment-flow",
        "reportPath": "build/reports/deployment-container-flow.json"
      }
    },
    {
      "obligationId": "PO-DEPLOYMENT-ROLLBACK-AUTHORIZATION",
      "method": "guard_validation",
      "params": {
        "highRiskEvents": [
          "rollback_requested",
          "rollback_applied"
        ],
        "requiredGuards": [
