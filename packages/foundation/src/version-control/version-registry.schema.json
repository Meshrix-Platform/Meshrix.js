{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshrix.local/packages/foundation/src/version-control/version-registry.schema.json",
  "x-governedVersion": "v0.0.1:version-governance:registry-schema-1",
  "title": "Meshrix Version Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "registryId",
    "protocolVersion",
    "updatedAt",
    "authority",
    "artifacts",
    "compatibilityTable",
    "transitions",
    "assemblies"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./version-registry.schema.json"
    },
    "schemaVersion": {
      "type": "string",
      "const": "v0.0.1:version-governance:registry-schema-1"
    },
    "registryId": {
      "type": "string",
      "const": "meshrix.version-registry"
    },
    "protocolVersion": {
      "type": "string",
      "const": "v0.0.1:version-governance:protocol-1"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "compatibilityTable": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compatibilityTableRow"
      }
    },
    "assemblies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assembly"
      }
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "artifactStoreRoot",
        "platformVersionBaseline",
        "governedVersionFormat"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "const": "source-controlled-singleton"
        },
        "artifactStoreRoot": {
          "type": "string",
          "const": ".meshrix-server-data/artifacts"
        },
        "platformVersionBaseline": {
          "type": "string",
          "const": "v0.0.1"
        },
        "governedVersionFormat": {
          "type": "string",
          "const": "v<platform-version>:<domain>:<subsection>-<version>"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "kind",
        "activeVersion",
        "versions"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/artifactId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "platform",
            "protocol",
            "schema",
            "store",
            "runtime_capability",
            "compatibility_projection",
            "policy",
            "state_machine",
            "module",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "activeVersion": {
          "$ref": "#/$defs/governedVersion"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifactVersion"
          }
        }
      }
    },
    "artifactVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "ref",
        "lifecycle",
        "compatibility",
        "artifactRefs",
        "evidenceRefs"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/governedVersion"
        },
        "ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "lifecycle": {
          "$ref": "#/$defs/artifactLifecycle"
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "artifactRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactPayloadRef"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transitionId",
        "artifactId",
        "fromVersion",
        "toVersion",
        "fromRef",
        "toRef",
        "lifecycle",
        "adjacent",
        "evidenceRefs"
      ],
      "properties": {
        "transitionId": {
          "type": "string",
          "minLength": 1
        },
        "artifactId": {
          "$ref": "#/$defs/artifactId"
        },
        "fromVersion": {
          "$ref": "#/$defs/governedVersion"
        },
        "toVersion": {
          "$ref": "#/$defs/governedVersion"
        },
        "fromRef": {
          "$ref": "#/$defs/artifactRef"
        },
        "toRef": {
          "$ref": "#/$defs/artifactRef"
        },
        "lifecycle": {
          "$ref": "#/$defs/transitionLifecycle"
        },
        "adjacent": {
          "type": "boolean"
        },
        "migrationPathConfigRef": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    },
    "compatibilityTableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibilityId",
        "consumerRef",
        "providerRef",
        "status",
        "newBindingsAllowed",
        "historicalResolutionAllowed",
        "evidenceRefs"
      ],
      "properties": {
        "compatibilityId": {
          "type": "string",
          "minLength": 1
        },
        "consumerRef": {
          "$ref": "#/$defs/artifactRef"
        },
        "providerRef": {
          "$ref": "#/$defs/artifactRef"
        },
        "status": {
          "type": "string",
          "enum": [
            "compatible",
            "deprecated",
            "historical_only",
            "blocked"
          ]
        },
        "newBindingsAllowed": {
          "type": "boolean"
        },
        "historicalResolutionAllowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assemblyId",
        "artifactRef",
        "lifecycle",
        "componentRefs",
        "evidenceRefs"
      ],
      "properties": {
        "assemblyId": {
          "$ref": "#/$defs/artifactRef"
        },
        "artifactRef": {
          "$ref": "#/$defs/artifactRef"
        },
        "lifecycle": {
          "$ref": "#/$defs/artifactLifecycle"
        },
        "componentRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "newBindingsAllowed",
        "historicalResolutionAllowed"
      ],
      "properties": {
        "newBindingsAllowed": {
          "type": "boolean"
        },
        "historicalResolutionAllowed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "artifactPayloadRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refId",
        "kind",
        "uri"
      ],
      "properties": {
        "refId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "bundle",
            "manifest",
            "report",
            "payload",
            "package",
            "other"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "kind",
        "uri"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "doc",
            "report",
            "manifest",
            "verifier",
            "other"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "artifactLifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "candidate",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "transitionLifecycle": {
      "type": "string",
      "enum": [
        "planned",
        "dry_run_passed",
        "checkpointed",
        "running",
        "verified",
        "completed",
        "failed",
        "rolled_back",
        "abandoned"
      ]
    },
    "artifactId": {
      "type": "string",
      "pattern": "^meshrix(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "governedVersion": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+:(?![a-z0-9-]*(?:legacy|compat|v[0-9]+))[a-z](?:[a-z0-9-]*[a-z0-9])?:(?![a-z0-9-]*(?:legacy|compat|v[0-9]+))[a-z](?:[a-z0-9-]*[a-z0-9])?-[0-9]+(?:\\.[0-9]+)*$"
    },
    "artifactRef": {
      "type": "string",
      "pattern": "^meshrix(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+@v[0-9]+\\.[0-9]+\\.[0-9]+:(?![a-z0-9-]*(?:legacy|compat|v[0-9]+))[a-z](?:[a-z0-9-]*[a-z0-9])?:(?![a-z0-9-]*(?:legacy|compat|v[0-9]+))[a-z](?:[a-z0-9-]*[a-z0-9])?-[0-9]+(?:\\.[0-9]+)*$"
    }
  }
}
