{
  "name": "@meshrix/foundation",
  "version": "0.0.1",
  "description": "Meshrix pure infrastructure primitives — security, policy, config, storage, proof, checkpoint, workflow, observability, module-system",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LicoLand/Meshrix.git",
    "directory": "packages/foundation"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "type": "module",
  "imports": {
    "#meshrix/authorization-engine": {
      "types": "./dist/security/authorization/authorization-engine.d.ts",
      "source": "./src/security/authorization/authorization-engine.ts",
      "default": "./dist/security/authorization/authorization-engine.js"
    },
    "#meshrix/client-strings": {
      "types": "./dist/security/client-strings.d.ts",
      "source": "./src/security/client-strings.ts",
      "default": "./dist/security/client-strings.js"
    },
    "#meshrix/server-config": {
      "types": "./dist/config/server-config.d.ts",
      "source": "./src/config/server-config.ts",
      "default": "./dist/config/server-config.js"
    },
    "#meshrix/trusted-client-ip": {
      "types": "./dist/security/trusted-client-ip.d.ts",
      "source": "./src/security/trusted-client-ip.ts",
      "default": "./dist/security/trusted-client-ip.js"
    }
  },
  "dependencies": {
    "@meshrix/contracts": "0.0.1",
    "better-sqlite3": "^12.9.0",
    "p-limit": "^7.3.0",
    "pactium": "0.7.0",
    "pg": "^8.21.0",
    "smol-toml": "^1.7.1",
    "undici": "^8.8.0"
  },
  "exports": {
    "./security/authorization/api-key-issuer-authority": {
      "types": "./dist/security/authorization/api-key-issuer-authority.d.ts",
      "source": "./src/security/authorization/api-key-issuer-authority.ts",
      "default": "./dist/security/authorization/api-key-issuer-authority.js"
    },
    "./security/authorization/api-key-verifier-key-provider": {
      "types": "./dist/security/authorization/api-key-verifier-key-provider.d.ts",
      "source": "./src/security/authorization/api-key-verifier-key-provider.ts",
      "default": "./dist/security/authorization/api-key-verifier-key-provider.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist/**/*",
    "config/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
