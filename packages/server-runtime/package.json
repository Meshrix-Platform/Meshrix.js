{
  "name": "@meshrix/server-runtime",
  "version": "0.0.1",
  "description": "Meshrix.js composition root, state stores, jobs, workers, product API",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "type": "module",
  "dependencies": {
    "@meshrix/agents": "0.0.1",
    "@meshrix/capabilities": "0.0.1",
    "@meshrix/contracts": "0.0.1",
    "@meshrix/foundation": "0.0.1",
    "@meshrix/protocols": "0.0.1"
  },
  "imports": {
    "#meshrix/agents/*": "@meshrix/agents/*",
    "#meshrix/capabilities/*": "@meshrix/capabilities/*",
    "#meshrix/client-strings": "@meshrix/foundation/security/client-strings",
    "#meshrix/contracts/*": "@meshrix/contracts/*",
    "#meshrix/foundation/*": "@meshrix/foundation/*",
    "#meshrix/http-response": "@meshrix/foundation/http/http-response",
    "#meshrix/http-utils": "@meshrix/protocols/http/http-utils",
    "#meshrix/operation-registry": "@meshrix/contracts/operations/operation-registry",
    "#meshrix/product-api": {
      "types": "./dist/composition/product-api.d.ts",
      "source": "./src/composition/product-api.ts",
      "default": "./dist/composition/product-api.js"
    },
    "#meshrix/protocols/*": "@meshrix/protocols/*",
    "#meshrix/runtime-logger": "@meshrix/foundation/observability/runtime-logger",
    "#meshrix/server-config": "@meshrix/foundation/config/server-config",
    "#meshrix/server-runtime/*": {
      "types": "./dist/*.d.ts",
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#meshrix/settings": {
      "types": "./dist/composition/settings.d.ts",
      "source": "./src/composition/settings.ts",
      "default": "./dist/composition/settings.js"
    },
    "#meshrix/state-coordinator": "@meshrix/foundation/storage/state-coordinator"
  },
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
