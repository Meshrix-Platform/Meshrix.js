      "default": "./dist/workspaces-view-context.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Meshrix-Platform/Meshrix.js.git",
    "directory": "packages/ui-console"
  },
  "homepage": "https://github.com/Meshrix-Platform/Meshrix.js#readme",
  "bugs": {
    "url": "https://github.com/Meshrix-Platform/Meshrix.js/issues"
  },
  "private": true
