      "default": "./dist/error-message.js"
    },
    "./option-bar": {
      "types": "./dist/types/option-bar.d.ts",
      "source": "./src/option-bar.ts",
      "import": "./dist/option-bar.js",
      "default": "./dist/option-bar.js"
    },
    "./OptionBar": {
      "types": "./dist/types/option-bar.d.ts",
      "source": "./src/option-bar.ts",
      "import": "./dist/option-bar.js",
      "default": "./dist/option-bar.js"
    },
    "./page-refresh": {
      "types": "./dist/types/page-refresh.d.ts",
      "source": "./src/page-refresh.ts",
      "import": "./dist/page-refresh.js",
      "default": "./dist/page-refresh.js"
    },
    "./rpc-client": {
      "types": "./dist/types/rpc-client.d.ts",
      "source": "./src/rpc-client.ts",
      "import": "./dist/rpc-client.js",
      "default": "./dist/rpc-client.js"
    },
    "./status-pill": {
      "types": "./dist/types/status-pill.d.ts",
      "source": "./src/status-pill.ts",
      "import": "./dist/status-pill.js",
      "default": "./dist/status-pill.js"
    },
    "./StatusPill": {
      "types": "./dist/types/status-pill.d.ts",
