{
  "name": "@meshrix/ui-console",
  "version": "0.0.1",
  "description": "Reusable Vue components and browser-side helpers for Meshrix.js consoles",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.config.ts && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "element-plus": "^2.13.7",
    "vue": "^3.5.32",
    "@element-plus/icons-vue": "^2.3.2"
  },
  "exports": {
    "./binary-checkbox": {
      "types": "./dist/types/binary-checkbox.d.ts",
      "source": "./src/binary-checkbox.ts",
      "import": "./dist/binary-checkbox.js",
      "default": "./dist/binary-checkbox.js"
    },
    "./BinaryCheckbox": {
      "types": "./dist/types/binary-checkbox.d.ts",
      "source": "./src/binary-checkbox.ts",
      "import": "./dist/binary-checkbox.js",
      "default": "./dist/binary-checkbox.js"
    },
    "./bridge-http": {
      "types": "./dist/types/bridge-http.d.ts",
      "source": "./src/bridge-http.ts",
      "import": "./dist/bridge-http.js",
      "default": "./dist/bridge-http.js"
    },
    "./browser-downloads": {
      "types": "./dist/types/browser-downloads.d.ts",
      "source": "./src/browser-downloads.ts",
      "import": "./dist/browser-downloads.js",
      "default": "./dist/browser-downloads.js"
    },
    "./browser-window": {
      "types": "./dist/types/browser-window.d.ts",
      "source": "./src/browser-window.ts",
      "import": "./dist/browser-window.js",
      "default": "./dist/browser-window.js"
    },
    "./console-client-display-utils": {
      "types": "./dist/types/console-client-display-utils.d.ts",
      "source": "./src/console-client-display-utils.ts",
      "import": "./dist/console-client-display-utils.js",
      "default": "./dist/console-client-display-utils.js"
    },
    "./console-format-utils": {
      "types": "./dist/types/console-format-utils.d.ts",
      "source": "./src/console-format-utils.ts",
      "import": "./dist/console-format-utils.js",
      "default": "./dist/console-format-utils.js"
    },
    "./error-message": {
      "types": "./dist/types/error-message.d.ts",
      "source": "./src/error-message.ts",
