{
  "schemaVersion": "v0.0.1:schema:definition-1",
  "name": "CommunicationService",
  "version": "v0.0.1:platform:communication-service-1",
  "category": "model-context-protocol",
  "agentCommunicationKind": "mcp",
  "applicationSubsystem": "communication-service",
  "description": "Platform communication capability directory for core protocol services.",
  "defaultLoaded": true,
  "protocol": "v0.0.1:platform:communication-service-1",
  "services": [
    {
      "serviceId": "mcp-server-side",
      "label": "MCP Server",
      "protocol": "mcp",
      "routeTarget": "mcp-server-side",
      "modulePath": "packages/protocols/mcp/adapter/http-mcp-adapter.ts"
    }
  ],
  "components": {
    "communicationService": {
      "path": "./index.ts",
      "factory": "createCommunicationServiceProvider",
      "exports": [
        "COMMUNICATION_SERVICE_ID",
        "COMMUNICATION_SERVICE_PROTOCOL_VERSION",
        "DEFAULT_COMMUNICATION_SERVICE_RECORDS",
        "createCommunicationServiceProvider"
      ],
      "requiredScopes": [
        "operation_permission:view"
      ],
      "maxRisk": "read_only",
      "auditRequired": true
    }
  },
  "verification": [
    "node tools/server-scripts/verify-communication-service.ts"
  ]
}
