{
  "name": "meshrix-mcp-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "GATEWAY",
        "class_name": "MeshrixGatewayDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MeshrixGatewayDO"]
    }
  ],
  "vars": {
    "DEMO_MODE": "false",
    // Keep "true" to allow admin-token approvals via /admin/approvals/:id/decide;
    // set "false" so only Entio-signed conclusions can release a permit.
    "ADMIN_DECIDE_ENABLED": "true",
    // Deployment label embedded in Entio approval requests shown on the phone.
    "ENTIO_INSTANCE": "meshrix-mcp-gateway"
  }
}
