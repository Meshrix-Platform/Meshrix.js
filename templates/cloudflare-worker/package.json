{
  "name": "meshrix-cloudflare-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "login": "wrangler login",
    "secret:admin": "wrangler secret put ADMIN_TOKEN --config wrangler.jsonc",
    "dev": "wrangler dev --config wrangler.jsonc",
    "dry-run": "wrangler deploy --dry-run --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:demo": "wrangler deploy --config wrangler.demo.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "tsc --noEmit && vitest run && wrangler deploy --dry-run --config wrangler.jsonc"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
