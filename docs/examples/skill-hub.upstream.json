{
  "kind": "meshrix.upstream-service",
  "schemaVersion": "v0.0.1:upstream-service:portable-import-2",
  "serviceKey": "skill-hub",
  "descriptor": {
    "serviceProtocol": "http",
    "label": "Skill Hub",
    "description": "Independent governed skill registry, lifecycle, and package custody service.",
    "baseUrl": "http://skill-hub:8080",
    "healthPath": "/readyz",
    "allowLocalNetwork": true,
    "tags": [
      "skill-hub",
      "skills"
    ],
    "trafficPolicy": {
      "perMinute": 600,
      "burst": 60,
      "maxConcurrent": 16
    },
    "operations": [
      {
        "operationKey": "skill_hub.search",
        "label": "Search Skill Hub",
        "protocol": "http",
        "method": "POST",
        "path": "/v1/operations/skill_hub.search",
        "risk": "read_only",
        "requiredScopes": [
          "workspace:read"
        ],
        "timeoutMs": 120000,
        "inputSchema": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "operationKey": "skill_hub.list",
        "label": "List Skill Hub skills",
        "protocol": "http",
        "method": "POST",
        "path": "/v1/operations/skill_hub.list",
        "risk": "read_only",
        "requiredScopes": [
          "workspace:read"
        ],
        "timeoutMs": 120000,
        "inputSchema": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "operationKey": "skill_hub.get",
        "label": "Read a Skill Hub skill",
        "protocol": "http",
        "method": "POST",
        "path": "/v1/operations/skill_hub.get",
        "risk": "read_only",
        "requiredScopes": [
          "workspace:read"
        ],
        "timeoutMs": 120000,
        "inputSchema": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "operationKey": "skill_hub.submit",
        "label": "Submit a Skill Hub skill",
        "protocol": "http",
        "method": "POST",
        "path": "/v1/operations/skill_hub.submit",
        "risk": "safe_write",
        "requiredScopes": [
          "workspace:write"
        ],
        "timeoutMs": 120000,
        "inputSchema": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "operationKey": "skill_hub.scan",
        "label": "Scan a Skill Hub revision in the controlled sandbox",
        "protocol": "http",
        "method": "POST",
        "path": "/v1/operations/skill_hub.scan",
        "risk": "repair_write",
        "requiredScopes": [
          "workspace:maintain"
        ],
        "timeoutMs": 120000,
        "inputSchema": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
