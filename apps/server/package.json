{
  "name": "@meshrix/server",
  "version": "0.0.1",
  "private": true,
  "description": "Meshrix Node server executable — HTTP runtime bootstrap, process lifecycle",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LicoLand/Meshrix.git",
    "directory": "apps/server"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "type": "module",
  "dependencies": {
    "@meshrix/contracts": "0.0.1",
    "@meshrix/foundation": "0.0.1",
    "@meshrix/protocols": "0.0.1",
    "@meshrix/server-runtime": "0.0.1",
    "@meshrix/ui-console": "0.0.1"
  },
  "imports": {
    "#meshrix/foundation/*": "@meshrix/foundation/*",
    "#meshrix/http-utils": "@meshrix/protocols/http/http-utils",
    "#meshrix/operation-registry": "@meshrix/contracts/operations/operation-registry",
    "#meshrix/platform-registry": "@meshrix/server-runtime/composition/platform-registry",
    "#meshrix/protocols/*": "@meshrix/protocols/*",
    "#meshrix/runtime-logger": "@meshrix/foundation/observability/runtime-logger",
    "#meshrix/server-config": "@meshrix/foundation/config/server-config",
    "#meshrix/server-runtime/*": "@meshrix/server-runtime/*"
  },
  "exports": {
    "./*": "./runtime/*.mjs"
  },
  "files": [
    "runtime/**/*.mjs",
    "LICENSE",
    "package.json"
  ]
}
