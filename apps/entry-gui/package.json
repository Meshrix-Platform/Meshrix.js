{
  "name": "@meshrix/entry-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Installed macOS/Windows entry product \u2014 Tauri 2 thin shell + Node.js sidecar backend + Vue renderer over @meshrix/entry and @meshrix/entry-transport.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main/service-entry.js",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.3.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc --noEmit -p tsconfig.web.json",
    "build:renderer": "vite build --config vite.config.ts",
    "build:service": "esbuild src/main/service-entry.ts --bundle --platform=node --format=esm --target=node22 --conditions=source --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/service/entry-service.mjs",
    "stage:service": "node tools/stage-service.mjs",
    "icons": "node tools/generate-icons.mjs",
    "dev": "tauri dev",
    "dev:renderer": "vite --config vite.config.ts",
    "dev:service": "npm run build:service --silent && node dist/service/entry-service.mjs",
    "pack:dir": "tauri build --no-bundle",
    "dist": "tauri build"
  },
  "dependencies": {
    "@meshrix/contracts": "0.1.0",
    "@meshrix/entry": "0.1.0",
    "@meshrix/entry-transport": "0.1.0",
    "@meshrix/gateway": "0.1.0",
    "@meshrix/peer-client": "0.1.0",
    "@meshrix/peer-crypto": "0.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.6",
    "esbuild": "^0.28.1",
    "vite": "^8.1.4",
    "vue": "^3.5.32"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "src-tauri/**/*",
    "index.html",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
